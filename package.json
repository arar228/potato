{
  "name": "night-arcade",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "predev": "pnpm --filter @night-arcade/shared build",
    "dev": "pnpm --parallel --filter @night-arcade/api --filter @night-arcade/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @night-arcade/api prisma:generate",
    "db:local": "node scripts/start-local-postgres.mjs",
    "db:migrate": "pnpm --filter @night-arcade/api prisma:migrate",
    "db:seed": "pnpm --filter @night-arcade/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.53.1"
  }
}
